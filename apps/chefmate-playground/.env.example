# Copy to .env. This local application only reads its own config file.
CHEFMATE_DATABASE_URL=postgresql://chefmate:YOUR_PASSWORD@127.0.0.1:5432/chefmate_test
CHEFMATE_DATABASE_SCHEMA=chefmate
CHEFMATE_USDA_DATABASE=../../data_cleaning/database/usda.db
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
CHEFMATE_AGENT_TIMEOUT=300
CHEFMATE_AGENT_MODEL_TIMEOUT=120
CHEFMATE_AGENT_MODEL_RETRIES=0
CHEFMATE_AGENT_MAX_ROUNDS=10
CHEFMATE_AGENT_MAX_TOOL_CALLS=20
# Character budgets for history/current tool messages and each tool result, not model tokens.
CHEFMATE_AGENT_MAX_HISTORY_CHARS=400000
CHEFMATE_AGENT_MAX_TOOL_RESULT_CHARS=60000
# Enable only after verifying the configured provider's streaming tool_calls.
CHEFMATE_AGENT_STREAM_TOOL_CALLS=false
# Explicit model capability and maximum images in one request, including retained history (1-12).
CHEFMATE_MODEL_SUPPORTS_IMAGES=false
CHEFMATE_MODEL_MAX_IMAGES=3
CHEFMATE_PLAYGROUND_PORT=18765
# Skills grant their documents and bound business tools; disabling one revokes both.
CHEFMATE_ENABLED_SKILLS=meal-planning,pantry-preparation,cooking-guide,recipe-authoring,personal-memory
