# Copy this file to .env in the repository root. Never commit the resulting .env.
# REQUIRED: set a unique 12+ character password before first startup.
# Bootstrap only creates this administrator when no matching account exists.
CHEFMATE_ADMIN_USERNAME=admin
CHEFMATE_ADMIN_PASSWORD=
# REQUIRED: PostgreSQL application data (accounts, sessions and personal records).
# Use a unique 20+ character password, distinct from the administrator password.
# Single-quote literal values containing $, #, spaces or other punctuation.
# Example syntax only: CHEFMATE_APP_DB_PASSWORD='replace@with:a$unique#password'
CHEFMATE_APP_DB_PASSWORD=
CHEFMATE_APP_DATABASE_SCHEMA=chefmate
# Initial seed only. Afterwards use the administrator's registration policy.
CHEFMATE_NEW_USER_COST_LIMIT_MICROS=5000000

# Default HTTP endpoint: http://127.0.0.1:18765
CHEFMATE_BIND_ADDRESS=127.0.0.1
CHEFMATE_HTTP_PORT=18765
CHEFMATE_ALLOWED_HOSTS=127.0.0.1,localhost,::1
CHEFMATE_COOKIE_SECURE=false
# When using HTTPS reverse proxy, set its actual fixed peer IP(s), comma separated.
# Uvicorn trusts X-Forwarded-Proto only from these addresses; do not use *.
FORWARDED_ALLOW_IPS=127.0.0.1

# Optional: configure here or in the administrator UI after startup.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1

# The bundled 358-recipe PostgreSQL catalog is initialized automatically.
CHEFMATE_DATABASE_SCHEMA=chefmate
# A container path after explicitly mounting an existing USDA database read-only.
CHEFMATE_USDA_DATABASE=

# Optional separate catalog password; blank uses CHEFMATE_APP_DB_PASSWORD.
CHEFMATE_POSTGRES_PASSWORD=
